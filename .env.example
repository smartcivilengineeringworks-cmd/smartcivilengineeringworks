# ================================================================
# SMART CIVIL WORKS - ENVIRONMENT VARIABLES CONFIGURATION
# ================================================================

# ----------------------------------------------------------------
# 1. DATABASE & BACKEND VARIABLES (Server-side)
# ----------------------------------------------------------------
# Neon PostgreSQL Connection Pool URL (Required)
DATABASE_URL="postgresql://neondb_owner:npg_haS3G7ujCofn@ep-square-sky-ayd8pf06-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Secret key used to sign and verify Admin JWT authentication tokens (Required)
JWT_SECRET="smart_civil_secret_key_2026_super_secure"

# Port for standalone backend server (Optional, default: 5000)
PORT=5000

# Allowed CORS origins for standalone backend (Optional, default: *)
CORS_ORIGIN="http://localhost:5173,https://smartcivilengineeringworks.rw"

# ----------------------------------------------------------------
# 2. FRONTEND VARIABLES (Client-side, prefixed with VITE_)
# ----------------------------------------------------------------
# Backend API Base URL
# - Leave empty or set to "/api" if backend and frontend are hosted together on Vercel
# - Set to "http://localhost:5000/api" if running frontend and backend on separate local ports
# - Set to "https://api.yourdomain.com/api" if deploying backend to a separate cloud server (Render/Railway)
VITE_API_URL="/api"

# Web3Forms Email Relay Access Key (Optional - for forwarding contact form submissions to email)
VITE_WEB3FORMS_ACCESS_KEY="your_web3forms_access_key_here"
